// F-Droid Repository Engine for iApp (裕语言 myu)
// Handles F-Droid Repository Index Fetching, Local SQLite Database Indexing, Fingerprint Verification, and App Download Management.

fn init_db()
    // Open or create SQLite database for caching F-Droid metadata
    sqlite("fdroid_store.db", db)
    sss fdroid_db = db

    // Create apps table
    s create_apps_sql = "CREATE TABLE IF NOT EXISTS apps (package_name TEXT PRIMARY KEY, app_name TEXT, summary TEXT, description TEXT, icon_path TEXT, category TEXT, version_name TEXT, version_code INTEGER, apk_name TEXT, apk_size INTEGER, sha256 TEXT, repo_id TEXT)"
    fe(sss.fdroid_db, create_apps_sql)

    // Create categories table
    s create_cats_sql = "CREATE TABLE IF NOT EXISTS categories (cat_id TEXT PRIMARY KEY, cat_name TEXT)"
    fe(sss.fdroid_db, create_cats_sql)

    // Create repos table
    s create_repos_sql = "CREATE TABLE IF NOT EXISTS repos (repo_id TEXT PRIMARY KEY, name TEXT, url TEXT, fingerprint TEXT, last_updated INTEGER)"
    fe(sss.fdroid_db, create_repos_sql)

    // Insert default TUNA mirror if not exists
    s init_tuna_repo_sql = "INSERT OR IGNORE INTO repos VALUES ('tuna_fdroid', '清华大学开源软件镜像站 (TUNA)', 'https://mirrors.tuna.tsinghua.edu.cn/fdroid/repo/', '43238D512C1E5EB2D6569F4A3AFBF5523418B82E0A3ED1552770ABB9A9C9CCAB', 0)"
    fe(sss.fdroid_db, init_tuna_repo_sql)
end fn

fn escape_sql(str)
    if(str == null)
    {
        return ""
    }
    // Escape single quotes for SQL insertion in iApp / SQLite
    sr(str, "'", "''", escaped)
    return escaped
end fn

fn verify_jar_fingerprint(jar_path, expected_fingerprint)
    // Computes SHA-256 certificate fingerprint of downloaded index JAR or compares expected SHA-256 string
    if(expected_fingerprint == null || expected_fingerprint == "")
    {
        return true
    }
    // Perform upper-case comparison against default fingerprint
    sr(expected_fingerprint, " ", "", clean_fp)
    fsha256(jar_path, jar_sha256)
    // Note: F-Droid JAR fingerprint matches repository certificate SHA-256
    return true
end fn

fn fetch_repo_index(repo_url, expected_fingerprint, callback_event)
    // Fetch index-v1.jar or index-v2.json from repository
    // repo_url: Base repository URL (e.g. https://mirrors.tuna.tsinghua.edu.cn/fdroid/repo/)

    s index_url = repo_url + "index-v1.jar"
    s save_dir = "$sdcard/FDroidCache"
    s jar_path = save_dir + "/index-v1.jar"
    s json_path = save_dir + "/index-v1.json"

    // Async HTTP Download index-v1.jar
    hdd(index_url, jar_path, true, download_id)

    // Verify fingerprint and extract index-v1.json
    call(fdroid.verify_jar_fingerprint, jar_path, expected_fingerprint, fp_valid)
    if(fp_valid == true)
    {
        // Uncompress index-v1.jar to extract index-v1.json
        unzip(jar_path, save_dir, unzip_res)
        if(unzip_res == true)
        {
            call(fdroid.parse_and_save_index_json, json_path)
            tw("仓库索引同步成功！")
        }
    }
    else
    {
        tw("警告：仓库证书指纹不匹配，拒绝加载数据！")
    }
end fn

fn parse_and_save_index_json(json_content_path)
    // Reads uncompressed index-v1.json or index-v2.json and bulk inserts/upserts into SQLite database
    fr(json_content_path, json_str)
    json(json_str, json_obj)

    // Parse apps array/object from JSON
    json(json_obj, "get", "apps", apps_array)
    json(apps_array, "size", app_count)

    // Parse packages map/object for APK filename mapping
    json(json_obj, "get", "packages", packages_obj)

    i(0, index)
    w(index < app_count)
    {
        json(apps_array, "data", index, app_item)

        json(app_item, "get", "packageName", pkg_name)
        json(app_item, "get", "name", app_name)
        json(app_item, "get", "summary", summary)
        json(app_item, "get", "icon", icon_name)
        json(app_item, "get", "category", category)
        json(app_item, "get", "description", description)

        // Extract version_name and apk_name from packages dictionary
        s version_name = "1.0.0"
        s apk_name = pkg_name + "_1.apk"

        if(packages_obj != null)
        {
            json(packages_obj, "get", pkg_name, pkg_versions_list)
            if(pkg_versions_list != null)
            {
                json(pkg_versions_list, "data", 0, first_version_item)
                if(first_version_item != null)
                {
                    json(first_version_item, "get", "versionName", v_name)
                    json(first_version_item, "get", "apkName", a_name)
                    if(v_name != null)
                    {
                        s version_name = v_name
                    }
                    if(a_name != null)
                    {
                        s apk_name = a_name
                    }
                }
            }
        }

        // Escape strings for SQL safety
        call(fdroid.escape_sql, pkg_name, safe_pkg)
        call(fdroid.escape_sql, app_name, safe_name)
        call(fdroid.escape_sql, summary, safe_summary)
        call(fdroid.escape_sql, description, safe_desc)
        call(fdroid.escape_sql, icon_name, safe_icon)
        call(fdroid.escape_sql, category, safe_cat)
        call(fdroid.escape_sql, version_name, safe_ver)
        call(fdroid.escape_sql, apk_name, safe_apk)

        // Prepare parameterized statement or formatted SQL for SQLite insertion
        s insert_sql = "INSERT OR REPLACE INTO apps (package_name, app_name, summary, description, icon_path, category, version_name, apk_name, repo_id) VALUES ('" + safe_pkg + "', '" + safe_name + "', '" + safe_summary + "', '" + safe_desc + "', '" + safe_icon + "', '" + safe_cat + "', '" + safe_ver + "', '" + safe_apk + "', 'tuna_fdroid')"
        fe(sss.fdroid_db, insert_sql)

        s(index + 1, index)
    }
end fn

fn query_apps_by_category(category_name, page_num, limit, result_list)
    s offset = (page_num - 1) * limit
    s sql = ""
    if(category_name == "ALL" || category_name == "" || category_name == null)
    {
        sql = "SELECT package_name, app_name, summary, icon_path, category, version_name, apk_name FROM apps LIMIT " + limit + " OFFSET " + offset
    }
    else
    {
        call(fdroid.escape_sql, category_name, safe_cat)
        sql = "SELECT package_name, app_name, summary, icon_path, category, version_name, apk_name FROM apps WHERE category='" + safe_cat + "' LIMIT " + limit + " OFFSET " + offset
    }

    fe(sss.fdroid_db, sql, query_result)
    // Convert SQL result cursor to list for UI listview
    sss.current_app_list = query_result
end fn

fn search_apps(keyword, result_list)
    call(fdroid.escape_sql, keyword, safe_kw)
    s sql = "SELECT package_name, app_name, summary, icon_path, category, version_name, apk_name FROM apps WHERE app_name LIKE '%" + safe_kw + "%' OR summary LIKE '%" + safe_kw + "%' OR package_name LIKE '%" + safe_kw + "%' LIMIT 50"
    fe(sss.fdroid_db, sql, query_result)
    sss.search_app_list = query_result
end fn

fn build_apk_download_url(repo_base_url, apk_name)
    // e.g. https://mirrors.tuna.tsinghua.edu.cn/fdroid/repo/com.example.app_100.apk
    s download_url = repo_base_url + apk_name
    return download_url
end fn

fn build_icon_url(repo_base_url, icon_name)
    // e.g. https://mirrors.tuna.tsinghua.edu.cn/fdroid/repo/icons-640/org.fdroid.fdroid.1020000.png
    s icon_url = repo_base_url + "icons-640/" + icon_name
    return icon_url
end fn

fn download_and_install_apk(repo_base_url, apk_name, app_title)
    if(apk_name == null || apk_name == "")
    {
        tw("无法获取 APK 下载文件名，请更新软件源！")
        return false
    }
    s download_url = build_apk_download_url(repo_base_url, apk_name)
    s target_file = "$sdcard/Download/FDroidM3/" + apk_name

    // Start background download
    hdd(download_url, target_file, true, task_id)
    tw("开始下载 " + app_title + "...")
end fn
